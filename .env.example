# 사용법: 이 파일을 복사해서 .env.local 을 만들고 값을 채우세요.
#   cp .env.example .env.local
#
# ⚠️ .env.local 은 절대 GitHub에 올리지 마세요. (.gitignore에 등록되어 있음)
#    키는 디스코드/카톡 DM으로 팀원에게 전달하세요.

# ============================================
# 해커톤(10시간)에 필요한 것 — 이 3개만 있으면 됩니다
# ============================================
SARAMIN_ACCESS_KEY=""        # https://oapi.saramin.co.kr  (채용공고 검색)
KAKAO_REST_API_KEY=""        # https://developers.kakao.com (주소 → 좌표)
ODSAY_API_KEY=""             # https://lab.odsay.com        (대중교통 시간·요금)
                             #   ※ 발급된 키를 인코딩하지 말고 그대로 붙여넣으세요

NEXT_PUBLIC_KAKAO_JS_KEY=""  # 지도를 넣을 여유가 있을 때만 필요

# ============================================
# 아래는 완성형(장기 프로젝트)에서만 사용 — 해커톤에서는 비워두세요
# ============================================
# DATABASE_URL="postgresql://realwage:realwage@localhost:5432/realwage"
# REDIS_URL="redis://localhost:6379"
# AUTH_SECRET=""             # openssl rand -base64 32
# AUTH_KAKAO_ID=""
# AUTH_KAKAO_SECRET=""
# CRON_SECRET=""             # /api/cron/* 호출 인증
# ROUTE_API_DAILY_BUDGET=900 # ODsay 일일 호출 상한
